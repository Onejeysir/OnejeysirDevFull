# Copie ce fichier en .env.local (développement) et renseigne les mêmes variables
# dans Vercel > Project > Settings > Environment Variables (production).
# AUCUNE de ces variables n'est envoyée au navigateur (pas de préfixe VITE_).

# Clé API Resend (https://resend.com/api-keys), format re_xxxxxxxx
RESEND_API_KEY=

# Ton adresse de réception professionnelle (jamais visible côté client)
CONTACT_TO_EMAIL=

# Expéditeur sur un domaine vérifié dans Resend, ex. Portfolio ONEJEYSIR <contact@ton-domaine.com>
# Pour un premier test sans domaine : onboarding@resend.dev (envoie uniquement vers l'adresse du compte Resend)
CONTACT_FROM_EMAIL=

# Facultatif : origines autorisées, séparées par des virgules, ex. https://ton-domaine.com
ALLOWED_ORIGINS=

# Facultatif : nombre d'envois par IP et par fenêtre de 10 minutes (défaut 5)
CONTACT_RATE_LIMIT=5

# Facultatif mais recommandé en production : limite partagée entre instances (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
